// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model Todo {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    
    title     String
    description String?
    done Boolean  @default(false)
    dueDate   DateTime?
    priority  String?      @default("LOW")
    tomatoes  Int      @default(0)
    hidden    Boolean  @default(false)
    source    String   @default("local")
    externalKey String?
    authorId String

    @@index([authorId])
    @@unique([authorId, externalKey])
}

model PomodoroSession {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    authorId  String
    todoId    String
    source    String   @default("local")
    externalSyncId String? @unique
    externalSessionId String?
    externalSessionLabel String?
    externalLayer String?
    externalSummary String?
    externalConceptTags String?

    @@index([authorId, createdAt])
    @@index([todoId])
}

model PomodoroUserProfile {
    authorId     String   @id
    primaryEmail String   @unique
    displayName  String?
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}
